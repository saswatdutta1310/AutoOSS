{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/cli.ts",
    "src/config.ts",
    "src/doctor.ts",
    "src/events.ts",
    "src/github/client.ts",
    "src/github/octokit.ts",
    "src/github/git.ts",
    "src/github/workspace.ts",
    "src/github/branchName.ts",
    "src/github/ingest.ts",
    "src/github/issueParser.ts"
  ]
}
